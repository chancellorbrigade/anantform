# Copy this file to .env and fill in your real values. Never commit .env.

# MongoDB Atlas connection string (Atlas free tier is fine)
# Get this from Atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/hackathon?retryWrites=true&w=majority

# Port the server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API
# e.g. the URL where you publish/host frontend/index.html
CORS_ORIGIN=http://localhost:5500,https://your-frontend-url.example

# Shared secret for the admin dashboard (admin.html). Pick something long and random.
ADMIN_KEY=change-this-to-something-long-and-random
